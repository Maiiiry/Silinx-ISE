# Digilent Basys2: the pins of feat_iobreg, its registers in the IOBs (#96; on pads where the
# bit database measured their kinds: led<1> on P6, the board's LED3; on M11, LED1, it has no output-enable
# register with a reset)
NET "clk"    LOC = "B8" | IOSTANDARD = LVCMOS33 ;
NET "sw<0>"  LOC = "P11" | IOSTANDARD = LVCMOS33 | IOB = TRUE ;
NET "sw<1>"  LOC = "L3" | IOSTANDARD = LVCMOS33 ;
NET "sw<2>"  LOC = "K3" | IOSTANDARD = LVCMOS33 ;
NET "sw<3>"  LOC = "B4" | IOSTANDARD = LVCMOS33 ;
NET "btn<0>" LOC = "G12" | IOSTANDARD = LVCMOS33 ;
NET "led<0>" LOC = "M5" | IOSTANDARD = LVCMOS33 | IOB = TRUE ;
NET "led<1>" LOC = "P6" | IOSTANDARD = LVCMOS33 | IOB = TRUE ;

# Timing constraints
NET "clk" TNM_NET = "clk" ;
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50% ;
