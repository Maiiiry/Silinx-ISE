# Digilent Nexys2-1200 (xc3s1200e-4-fg320): the pins this board test uses
NET "clk"    LOC = "B8" | IOSTANDARD = LVCMOS33 ;
NET "sclk"   LOC = "U9" | IOSTANDARD = LVCMOS33 ;
NET "led<0>" LOC = "J14" | IOSTANDARD = LVCMOS33 ;
NET "led<1>" LOC = "J15" | IOSTANDARD = LVCMOS33 ;
NET "led<2>" LOC = "K15" | IOSTANDARD = LVCMOS33 ;
NET "led<3>" LOC = "K14" | IOSTANDARD = LVCMOS33 ;
NET "led<4>" LOC = "E16" | IOSTANDARD = LVCMOS33 ;
NET "led<5>" LOC = "P16" | IOSTANDARD = LVCMOS33 ;
NET "led<6>" LOC = "E4" | IOSTANDARD = LVCMOS33 ;
NET "led<7>" LOC = "P4" | IOSTANDARD = LVCMOS33 ;
